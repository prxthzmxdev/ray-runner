SHINEMONITOR_BASE_URL=https://web.shinemonitor.com/public/
SHINEMONITOR_USERNAME=your_shinemonitor_username
SHINEMONITOR_PASSWORD=your_shinemonitor_password
SHINEMONITOR_COMPANY_KEY=your_company_key
# Login: auth (default) or authEmail (vsole-style)
SHINEMONITOR_AUTH_ACTION=auth
SHINEMONITOR_PLANT_ID=your_plant_id
# Optional override; leave empty to use dynamic today's date (Asia/Kolkata)
SHINEMONITOR_DATE=
SHINEMONITOR_I18N=en_US
SHINEMONITOR_LANG=en_US
SHINEMONITOR_TIMEOUT=20

# Solar site context for weather/sunrise/sunset adjustments
SOLAR_TIMEZONE=Asia/Kolkata
SOLAR_LATITUDE=
SOLAR_LONGITUDE=
WEATHER_API_TIMEOUT=15

# Recommendation cache (seconds)
SNAPSHOT_CACHE_SECONDS=90
SNAPSHOT_FORCE_TTL_SECONDS=60
TODAY_REFRESH_MINUTES=15
SOLAR_DB_PATH=solar_data.db

# Logging
LOG_LEVEL=INFO

# Telegram bot (set token to enable polling mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_MODE=polling  # polling or webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_REQUEST_TIMEOUT=30
TELEGRAM_HANDLER_CONCURRENCY=4
